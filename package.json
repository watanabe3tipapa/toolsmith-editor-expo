{
  "name": "toolsmith-editor-expo",
  "version": "0.1.0",
  "private": true,
  "description": "TOOLSMITH EDITOR Expo edition - local-first Markdown workspace for iOS and Android",
  "license": "MIT",
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "build:editor": "npm run build -w @toolsmith/editor-web",
    "dev": "npm run start -w @toolsmith/mobile",
    "ios": "npm run ios -w @toolsmith/mobile",
    "android": "npm run android -w @toolsmith/mobile",
    "typecheck": "npm run typecheck -w @toolsmith/shared && npm run typecheck -w @toolsmith/editor-web && npm run typecheck -w @toolsmith/mobile",
    "test": "npm run test -w @toolsmith/shared",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "react": "19.3.0",
    "react-native-safe-area-context": "5.10.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
